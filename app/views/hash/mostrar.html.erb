<!DOCTYPE html>
<html>
<head>
  <title>Datos de la persona</title>
</head>

<body>

  <h1>Hash#mostrar</h1>

  <p>Datos almacenados en un Hash de Ruby</p>

  <h2>Datos de la persona</h2>

  <table>
    <tr>
      <th>Dato</th>
      <th>Información</th>
    </tr>

    <tr>
      <td>Nombre</td>
      <td><%= @persona[:nombre] %></td>
    </tr>

    <tr>
      <td>Apellido</td>
      <td><%= @persona[:apellido] %></td>
    </tr>

    <tr>
      <td>Teléfono</td>
      <td><%= @persona[:telefono] %></td>
    </tr>

    <tr>
      <td>Correo</td>
      <td><%= @persona[:correo] %></td>
    </tr>
  </table>

</body>
</html>
